{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "ProfessorDubbedPro",
	"version": "0.2.1",
	"identifier": "com.professordubbedpro.app",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "node scripts/ensure-ffmpeg.mjs && node scripts/ensure-whisper.mjs && node scripts/ensure-ytdlp.mjs && pnpm dev",
		"beforeBuildCommand": "node scripts/ensure-ffmpeg.mjs && node scripts/ensure-whisper.mjs && node scripts/ensure-ytdlp.mjs && pnpm build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "ProfessorDubbedPro",
				"width": 1440,
				"height": 900,
				"minWidth": 1100,
				"minHeight": 700,
				"resizable": true,
				"fullscreen": false,
				"center": true,
				"decorations": false,
				"transparent": false,
				"shadow": true,
				"focus": true,
				"dragDropEnabled": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		},
		"macOSPrivateApi": false
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": ["binaries/ffmpeg", "binaries/yt-dlp"],
		"resources": ["resources/fonts/*"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
